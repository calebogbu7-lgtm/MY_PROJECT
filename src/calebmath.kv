<CalculatorLayout>:
    orientation: "vertical"
    padding: 14
    spacing: 10

    canvas.before:
        Color:
            rgba: (0.07, 0.08, 0.12, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    TextInput:
        id: display
        text: ""
        readonly: True
        multiline: False
        halign: "right"
        font_size: "38sp"
        size_hint: (1, 0.22)
        padding: 12, 18
        background_normal: ""
        background_active: ""
        background_color: (0.12, 0.14, 0.19, 1)
        foreground_color: (0.96, 0.97, 1, 1)
        cursor_blink: False

    GridLayout:
        cols: 4
        spacing: 8
        size_hint: (1, 0.78)

        Button:
            text: "AC"
            background_normal: ""
            background_color: (0.75, 0.20, 0.24, 1)
            color: (1, 1, 1, 1)
            font_size: "20sp"
            on_release: root.on_button_press(self)

        Button:
            text: "DEL"
            background_normal: ""
            background_color: (0.75, 0.20, 0.24, 1)
            color: (1, 1, 1, 1)
            font_size: "18sp"
            on_release: root.on_button_press(self)

        Button:
            text: "("
            background_normal: ""
            background_color: (0.22, 0.25, 0.33, 1)
            color: (1, 1, 1, 1)
            font_size: "22sp"
            on_release: root.on_button_press(self)

        Button:
            text: ")"
            background_normal: ""
            background_color: (0.22, 0.25, 0.33, 1)
            color: (1, 1, 1, 1)
            font_size: "22sp"
            on_release: root.on_button_press(self)

        Button:
            text: "7"
            background_normal: ""
            background_color: (0.15, 0.17, 0.22, 1)
            color: (1, 1, 1, 1)
            font_size: "24sp"
            on_release: root.on_button_press(self)

        Button:
            text: "8"
            background_normal: ""
            background_color: (0.15, 0.17, 0.22, 1)
            color: (1, 1, 1, 1)
            font_size: "24sp"
            on_release: root.on_button_press(self)

        Button:
            text: "9"
            background_normal: ""
            background_color: (0.15, 0.17, 0.22, 1)
            color: (1, 1, 1, 1)
            font_size: "24sp"
            on_release: root.on_button_press(self)

        Button:
            text: "/"
            background_normal: ""
            background_color: (0.22, 0.25, 0.33, 1)
            color: (0.45, 0.72, 1, 1)
            font_size: "24sp"
            on_release: root.on_button_press(self)

        Button:
            text: "4"
            background_normal: ""
            background_color: (0.15, 0.17, 0.22, 1)
            color: (1, 1, 1, 1)
            font_size: "24sp"
            on_release: root.on_button_press(self)

        Button:
            text: "5"
            background_normal: ""
            background_color: (0.15, 0.17, 0.22, 1)
            color: (1, 1, 1, 1)
            font_size: "24sp"
            on_release: root.on_button_press(self)

        Button:
            text: "6"
            background_normal: ""
            background_color: (0.15, 0.17, 0.22, 1)
            color: (1, 1, 1, 1)
            font_size: "24sp"
            on_release: root.on_button_press(self)

        Button:
            text: "*"
            background_normal: ""
            background_color: (0.22, 0.25, 0.33, 1)
            color: (0.45, 0.72, 1, 1)
            font_size: "24sp"
            on_release: root.on_button_press(self)

        Button:
            text: "1"
            background_normal: ""
            background_color: (0.15, 0.17, 0.22, 1)
            color: (1, 1, 1, 1)
            font_size: "24sp"
            on_release: root.on_button_press(self)

        Button:
            text: "2"
            background_normal: ""
            background_color: (0.15, 0.17, 0.22, 1)
            color: (1, 1, 1, 1)
            font_size: "24sp"
            on_release: root.on_button_press(self)

        Button:
            text: "3"
            background_normal: ""
            background_color: (0.15, 0.17, 0.22, 1)
            color: (1, 1, 1, 1)
            font_size: "24sp"
            on_release: root.on_button_press(self)

        Button:
            text: "-"
            background_normal: ""
            background_color: (0.22, 0.25, 0.33, 1)
            color: (0.45, 0.72, 1, 1)
            font_size: "24sp"